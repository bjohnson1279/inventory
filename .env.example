# ==============================================================================
# Polyglot Inventory Management DDD Study — Environment Configuration Template
# ==============================================================================

# --- Database Credentials (PostgreSQL 16 + TimescaleDB) ---
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_password
POSTGRES_DB=inventory_db
POSTGRES_PORT=5432

# --- Redis Credentials (Redis 7) ---
REDIS_PORT=6379

# --- AI Microservice Sidecar ---
SIDECAR_PORT=5005

# --- Backend Host Port Bindings ---
GQL_PORT=4000
EXPRESS_PORT=5000
PHP_PORT=8000
PYTHON_PORT=8001

# --- Frontend Single-Page Application ---
CLIENT_PORT=3000

# --- Security & Third-Party Secrets ---
JWT_SECRET=test-jwt-secret
SHOPIFY_API_SECRET=test-shopify-secret
